{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",       // đổi thành đường dẫn đúng, vd: "app.main:app"
        "--reload",
        "--port", "8000"
      ],
      "jinja": true,
      "justMyCode": true  // false nếu muốn step vào code của thư viện
    }
  ]
}